{
  "log_level": "all",
  "max_lines_per_file": {
    "enabled": true,
    "warning": 300,
    "error": 500,
    "exclude_patterns": ["node_modules/**", ".omx/**", "dist/**", "build/**", "coverage/**", ".git/**", "code_analysis_results/**"]
  },
  "pmd_duplicates": {
    "enabled": true,
    "minimum_tokens": 100,
    "exclude_patterns": {
      "javascript": ["**/node_modules/**", "**/.omx/**", "**/dist/**", "**/build/**", "**/code_analysis_results/**"]
    }
  },
  "pmd_similar_code": {
    "enabled": false,
    "minimum_tokens": 100,
    "ignore_identifiers": true,
    "ignore_literals": true,
    "ignore_annotations": false,
    "exclude_patterns": {
      "javascript": ["**/node_modules/**", "**/.omx/**", "**/dist/**", "**/build/**", "**/code_analysis_results/**"]
    }
  },
  "eslint_analyze": {
    "enabled": true,
    "config_mode": "auto",
    "exclude_patterns": ["node_modules/**", "coverage/**"]
  }
}
