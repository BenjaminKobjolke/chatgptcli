{
  "name": "chatgptcli",
  "version": "0.1.3",
  "description": "Web-backed ChatGPT CLI via opencli Browser Bridge",
  "type": "module",
  "bin": {
    "chatgptcli": "src/main.js"
  },
  "scripts": {
    "start": "bun run src/main.js",
    "setup": "bun run src/main.js setup",
    "build": "bun build --compile --outfile chatgptcli.exe src/main.js",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "eslint": "^10.8.1"
  }
}
